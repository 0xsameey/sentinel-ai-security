  "components": {
    "securitySchemes": {
      "walletJwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "agentKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Sentinel-Agent-Key"
      },
      "workerKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Sentinel-Worker-Key"
      }
    },
    "schemas": {
      "Intent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recipient",
          "amountYocto",
          "expiresAtNs",
          "purpose"
        ],
        "properties": {
          "recipient": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "amountYocto": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,38}$"
          },
          "expiresAtNs": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "CreateDelegation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "agent",
          "maxPayment",
          "budget",
          "dailyLimit",
          "expiresAtNs",
          "recipients"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "agent": {
            "type": "string"
          },
          "maxPayment": {
            "type": "string"
          },
          "budget": {
            "type": "string"
          },
          "dailyLimit": {
            "type": "string"
          },
          "expiresAtNs": {
            "type": "string"
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Proposal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delegationId",
          "intent"
        ],
        "properties": {
          "delegationId": {
            "type": "string"
          },
          "intent": {
            "$ref": "#/components/schemas/Intent"
          }
        }
      },
      "Approval": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "confirm"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "confirm": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "ConsumePermit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "permitId",
          "intentHash"
        ],
        "properties": {
          "permitId": {
            "type": "string",
            "format": "uuid"
          },
          "intentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delegationId",
          "task",
          "recipient",
          "maxAmountYocto"
        ],
        "properties": {
          "delegationId": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "maxAmountYocto": {
            "type": "string"
          }
        }
      },
      "Report": {
        "type": "object",
        "required": [
          "transactionHash",
          "operation"
        ],
        "properties": {
          "transactionHash": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "Execution"
            ]
          }
        }
      }
    }
  }
}
