{
  "openapi": "3.0.3",
  "info": {
    "title": "Sentinel Milestone 5B additive delegation API",
    "version": "5B",
    "description": "Owner-approved APIs remain unchanged. Amounts and nanoseconds are decimal strings. Transfer settlement is reconstructed from chain payment status and delegation binding. Worker reports remain unverified."
  },
  "paths": {
    "/api/v1/delegations": {
      "get": {
        "summary": "List up to 100 indexed delegation IDs",
        "security": [
          {
            "walletJwt": []
          },
          {
            "agentKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted/observed data or prepared call; never implicit settlement"
          },
          "400": {
            "description": "Invalid fields"
          },
          "401": {
            "description": "Missing authentication"
          },
          "403": {
            "description": "Actor is not authorized"
          },
          "409": {
            "description": "Changed authority, expired/used permit, or claim conflict"
          },
          "422": {
            "description": "BLOCK or human review required"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      },
      "post": {
        "summary": "Prepare an owner-wallet create_delegation call; does not create chain authority",
        "security": [
          {
            "walletJwt": []
          }
